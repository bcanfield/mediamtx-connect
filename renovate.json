{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "* 0-5 * * *"
  ],
  "prHourlyLimit": 0,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^0/",
      "groupName": "0.x minor dependencies",
      "groupSlug": "zero-minor",
      "automerge": false,
      "semanticCommitType": "fix"
    },
    {
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "fix",
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github actions major"
    },
    {
      "description": "v10 needs conventional-changelog-writer 9; semantic-release 25 bundles 8 and silently renders empty release notes. See pnpm-workspace.yaml.",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10"
    }
  ]
}

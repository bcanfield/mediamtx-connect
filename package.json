{
  "name": "mediamtx-connect",
  "private": true,
  "scripts": {
    "dev": "node scripts/seed-fixtures.mjs && docker compose -f docker-compose.dev.yml up -d && turbo dev",
    "dev:stop": "docker compose -f docker-compose.dev.yml down",
    "build": "turbo build && rm -rf apps/api/public && cp -R apps/web/dist apps/api/public",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:check": "pnpm run i18n:check:messages && pnpm run i18n:check:readme",
    "i18n:check:messages": "node scripts/i18n-check.mjs",
    "i18n:check:readme": "node scripts/readme-i18n-check.mjs",
    "test": "turbo test && pnpm test:scripts",
    "test:scripts": "vitest run --dir scripts",
    "test:watch": "turbo test:watch",
    "test:changed": "turbo test --force -- --changed",
    "check": "node scripts/check.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm i18n:check && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@e18e/eslint-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/git": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "eslint-plugin-antfu": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semantic-release": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.28.9"
}
